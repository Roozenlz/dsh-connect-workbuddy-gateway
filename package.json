{
  "name": "dsh-connect-workbuddy-gateway",
  "version": "1.1.0",
  "description": "把 dsh-connect-workbuddy 的 WorkBuddy 模型开放成本机 API：OpenAI Chat / Responses、Anthropic Messages、Gemini 四协议共用一个 base URL，模型按 API key 逐个勾选。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "gateway",
    "openai-compatible",
    "anthropic",
    "gemini",
    "llm-gateway",
    "codex",
    "claude-code"
  ],
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Roozenlz",
    "url": "https://github.com/Roozenlz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roozenlz/dsh-connect-workbuddy-gateway.git"
  },
  "homepage": "https://github.com/Roozenlz/dsh-connect-workbuddy-gateway#readme",
  "bugs": {
    "url": "https://github.com/Roozenlz/dsh-connect-workbuddy-gateway/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
