{
  "name": "dsh-workbuddy-gateway",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "把 dsh-connect-workbuddy 提供的 WorkBuddy 模型开放成本机可调用的 API：OpenAI Chat / OpenAI Responses / Anthropic Messages / Gemini 四种协议共用一个 base URL，路由策略挂在 API key 上并在设置页里管理。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "gateway",
    "openai-compatible",
    "anthropic",
    "gemini"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
